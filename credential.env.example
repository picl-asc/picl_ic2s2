# Copy this file to `credential.env` and fill in your own values.
# `credential.env` is listed in .gitignore and will never be committed.

# ---- TikTok Research API (used in Section 2-1) ----------------------------
# Get these from https://developers.tiktok.com/products/research-api/
# (academic-only; review takes a few weeks).
CLIENT_KEY="your_client_key_here"
CLIENT_SECRET="your_client_secret_here"

# ---- Apify (used in Section 2-2) -----------------------------------------
# Get this from https://apify.com/ → Settings → Integrations → API Token.
# Free tier includes $5 in credits.
APIFY_API_TOKEN="your_apify_token_here"

# ---- TikTok Session ID (used in Section 2-3) -----------------------------
# Get this from your browser cookies when logged into TikTok.
SESSIONID="your_sessionid_here"